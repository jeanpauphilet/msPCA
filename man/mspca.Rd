             feasibilityTolerance = 1e-4, stallingTolerance = 1e-8,
             timeLimitTPM = 20, maxRestartTPM = 30, minRestartTPM = 20,
             verbose = FALSE, checkPSD = TRUE,
             symTolerance = 1e-8, psdTolerance = 1e-8)
